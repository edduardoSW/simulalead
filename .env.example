# Copie para .env.local apenas no desenvolvimento. Na Vercel, cadastre os
# valores em Settings > Environment Variables e nunca publique .env.local.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=180
GEMINI_THINKING_LEVEL=minimal
GEMINI_USER_RPM_LIMIT=4
GEMINI_USER_DAILY_REQUEST_LIMIT=50
GEMINI_USER_DAILY_TOKEN_LIMIT=200000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_server_only
